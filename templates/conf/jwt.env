LIVEKIT_URL=wss://${rtc_host}
LIVEKIT_KEY=${livekit_key}
LIVEKIT_SECRET=${livekit_secret}
LIVEKIT_JWT_BIND=:8080
LIVEKIT_FULL_ACCESS_HOMESERVERS=${server_name}
# Application-service mode: Synapse proxies /rtc/livekit to us and we check room membership.
LIVEKIT_AS_REGISTRATION_FILE=/etc/lk-jwt/registration.yaml
LIVEKIT_HS_SERVER_NAME=${server_name}
# A full URL: a bare host fails membership checks ("relative URL without a base"). It resolves to Caddy.
LIVEKIT_CS_API_URL_OVERRIDES=${server_name}=https://${matrix_host}
# Pull-based fallback if a participant-disconnect webhook is missed.
LIVEKIT_SANITY_CHECK_INTERVAL_SECONDS=60
